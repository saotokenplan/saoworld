#!/usr/bin/env python3
"""
Git commit-msg hook: validates commit message format.
Redirects to tools/validate-commit-msg.py for actual validation logic.
"""

import subprocess
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
VALIDATOR = REPO_ROOT / "tools" / "validate-commit-msg.py"

if not VALIDATOR.exists():
    print("Warning: commit message validator not found at {}".format(VALIDATOR), file=sys.stderr)
    print("Skipping validation (install tools/validate-commit-msg.py first)", file=sys.stderr)
    sys.exit(0)

commit_msg_file = sys.argv[1] if len(sys.argv) > 1 else None
if not commit_msg_file:
    print("Error: no commit message file provided", file=sys.stderr)
    sys.exit(1)

result = subprocess.run(
    [sys.executable, str(VALIDATOR), commit_msg_file],
    cwd=str(REPO_ROOT),
)
sys.exit(result.returncode)
