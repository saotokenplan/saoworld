; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   parameter=value
;   parameter=value
;   ...
;   [section.name] ; sub-sections go after the parent section
;   ...

config_version=5

[application]

config/name="OpenWorldVoteGame"
config/description="玩家投票驱动、AI持续生成内容的大型开放式在线游戏客户端"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/autoload/GameState.gd"
APIManager="*res://scripts/autoload/APIManager.gd"
VoteManager="*res://scripts/autoload/VoteManager.gd"
ContentManager="*res://scripts/autoload/ContentManager.gd"
AudioManager="*res://scripts/autoload/AudioManager.gd"
PlayerManager="*res://scripts/autoload/PlayerManager.gd"
WorldManager="*res://scripts/autoload/WorldManager.gd"
CombatManager="*res://scripts/autoload/CombatManager.gd"
SaveManager="*res://scripts/autoload/SaveManager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

