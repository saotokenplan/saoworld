# Gateway Service Configuration
# Prefix: GATEWAY_

# Service Settings
GATEWAY_APP_NAME=gateway-service
GATEWAY_APP_VERSION=0.1.0
GATEWAY_DEBUG=true
GATEWAY_ENVIRONMENT=local

# JWT Settings
GATEWAY_JWT_SECRET=change-me-in-production
GATEWAY_JWT_ALGORITHM=HS256
GATEWAY_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Rate Limiting
GATEWAY_RATE_LIMIT_REQUESTS_PER_MINUTE=60
GATEWAY_RATE_LIMIT_CONCURRENT_REQUESTS=100

# Request Timeout (seconds)
GATEWAY_REQUEST_TIMEOUT=30

# Logging
GATEWAY_LOG_LEVEL=INFO

# API Prefix
GATEWAY_API_V1_PREFIX=/api/v1

# Request Headers
GATEWAY_REQUEST_ID_HEADER=X-Request-Id
GATEWAY_TRACE_ID_HEADER=X-Trace-Id
GATEWAY_IDEMPOTENCY_KEY_HEADER=Idempotency-Key

# Backend Service URLs
GATEWAY_VOTE_SERVICE_URL=http://localhost:8001
GATEWAY_WORLD_SERVICE_URL=http://localhost:8002
GATEWAY_CONTENT_SERVICE_URL=http://localhost:8003
GATEWAY_GENERATION_SERVICE_URL=http://localhost:8004
GATEWAY_REVIEW_SERVICE_URL=http://localhost:8005