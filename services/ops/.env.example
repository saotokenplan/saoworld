# Ops Service Configuration
OPS_APP_NAME=ops-service
OPS_APP_VERSION=0.1.0
OPS_DEBUG=false
OPS_ENVIRONMENT=local

# Database
OPS_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ops_db

# JWT
OPS_JWT_SECRET=change-me-in-production
OPS_JWT_ALGORITHM=HS256
OPS_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Logging
OPS_LOG_LEVEL=INFO

# API
OPS_API_V1_PREFIX=/api/v1
OPS_REQUEST_ID_HEADER=X-Request-Id
OPS_TRACE_ID_HEADER=X-Trace-Id
OPS_IDEMPOTENCY_KEY_HEADER=Idempotency-Key

# Service URLs for health checks
OPS_VOTE_SERVICE_URL=http://localhost:8000
OPS_WORLD_SERVICE_URL=http://localhost:8001
OPS_CONTENT_SERVICE_URL=http://localhost:8002
OPS_GENERATION_SERVICE_URL=http://localhost:8003
OPS_REVIEW_SERVICE_URL=http://localhost:8004
OPS_GATEWAY_SERVICE_URL=http://localhost:8005
OPS_PLAYER_SERVICE_URL=http://localhost:8006
OPS_OPS_SERVICE_URL=http://localhost:8007
OPS_HEALTH_CHECK_TIMEOUT=5
