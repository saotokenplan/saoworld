# Player Service Configuration
PLAYER_APP_NAME=player-service
PLAYER_APP_VERSION=0.1.0
PLAYER_DEBUG=false
PLAYER_ENVIRONMENT=local

# Database
PLAYER_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/player_db

# JWT
PLAYER_JWT_SECRET=change-me-in-production
PLAYER_JWT_ALGORITHM=HS256
PLAYER_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Logging
PLAYER_LOG_LEVEL=INFO

# API
PLAYER_API_V1_PREFIX=/api/v1
PLAYER_REQUEST_ID_HEADER=X-Request-Id
PLAYER_TRACE_ID_HEADER=X-Trace-Id
PLAYER_IDEMPOTENCY_KEY_HEADER=Idempotency-Key