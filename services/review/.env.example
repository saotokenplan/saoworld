REVIEW_APP_NAME=review-service
REVIEW_APP_VERSION=0.1.0
REVIEW_DEBUG=true
REVIEW_ENVIRONMENT=local
REVIEW_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/review_db
REVIEW_JWT_SECRET=change-me-in-production
REVIEW_JWT_ALGORITHM=HS256
REVIEW_ACCESS_TOKEN_EXPIRE_MINUTES=30
REVIEW_LOG_LEVEL=INFO
REVIEW_REQUEST_ID_HEADER=X-Request-Id
REVIEW_TRACE_ID_HEADER=X-Trace-Id
REVIEW_IDEMPOTENCY_KEY_HEADER=Idempotency-Key
REVIEW_API_V1_PREFIX=/api/v1