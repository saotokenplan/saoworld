{
  "title": "审核效率看板 (Review Efficiency)",
  "uid": "review-efficiency",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": { "from": "now-7d", "to": "now" },
  "timepicker": {},
  "templating": { "list": [] },
  "annotations": { "list": [{ "builtIn": 1, "datasource": "-- Grafana --", "enable": true, "hide": true, "iconColor": "rgba(0, 211, 255, 1)", "name": "Annotations & Alerts", "type": "dashboard" }] },
  "refresh": "1m",
  "tags": ["review", "m4", "efficiency"],
  "timezone": "browser",
  "panelPreviews": [],
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "L1 · 自动审核通过率 (K1)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "thresholds": [
          { "color": "red", "value": null },
          { "color": "yellow", "value": 0.7 },
          { "color": "green", "value": 0.8 }
        ]
      },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(reviews_total{result=\"approved\",review_type=\"auto\"}[1h])) / sum(rate(reviews_total{review_type=\"auto\"}[1h]))",
          "legendFormat": "auto_pass_rate",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "L1 · 审核耗时 P95 (K2)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "thresholds": [
          { "color": "green", "value": null },
          { "color": "yellow", "value": 1800 },
          { "color": "red", "value": 1800.0001 }
        ]
      },
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(review_duration_seconds_bucket[1h])) by (le))",
          "legendFormat": "p95_seconds",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "L1 · 人工介入率 (K3)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "thresholds": [
          { "color": "green", "value": null },
          { "color": "yellow", "value": 0.3 }
        ]
      },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(reviews_total{result=\"manual_review\",review_type=\"auto\"}[1h])) / sum(rate(reviews_total{review_type=\"auto\"}[1h]))",
          "legendFormat": "manual_intervention_rate",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "L1 · 审核积压量 (A4)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "thresholds": [
          { "color": "green", "value": null },
          { "color": "yellow", "value": 50 }
        ]
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 },
        "overrides": []
      },
      "targets": [
        { "expr": "sum(pending_review_count)", "legendFormat": "backlog", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "title": "L2 · 通过率 / 人工介入率 趋势 (K1/K3)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(reviews_total{result=\"approved\",review_type=\"auto\"}[1h])) / sum(rate(reviews_total{review_type=\"auto\"}[1h]))",
          "legendFormat": "通过率",
          "refId": "A"
        },
        {
          "expr": "sum(rate(reviews_total{result=\"manual_review\",review_type=\"auto\"}[1h])) / sum(rate(reviews_total{review_type=\"auto\"}[1h]))",
          "legendFormat": "人工介入率",
          "refId": "B"
        }
      ]
    },
    {
      "id": 6,
      "title": "L2 · 审核结果分布趋势 (按 result)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(reviews_total{review_type=\"auto\"}[1h])) by (result)",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "L3 · 审核耗时分布 (P50/P95 by review_type)",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 14 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(review_duration_seconds_bucket[1h])) by (le, review_type))",
          "legendFormat": "P50 {{review_type}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(review_duration_seconds_bucket[1h])) by (le, review_type))",
          "legendFormat": "P95 {{review_type}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 8,
      "title": "L3 · 审核耗时热力图 (by review_type)",
      "type": "heatmap",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 14 },
      "options": {
        "calculate": false,
        "legend": { "show": true },
        "tooltip": { "show": true, "yHistogram": false }
      },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "hideZeroBuckets": true } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(review_duration_seconds_bucket[1h])) by (le, review_type)",
          "legendFormat": "{{review_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "L4 · 规则判定分布 (A3 归因, by rule×result)",
      "type": "barchart",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 23 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "single", "sort": "none" },
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "fillOpacity": 80, "lineWidth": 1 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(review_rule_decisions_total[1d])) by (rule, result)",
          "legendFormat": "{{rule}} / {{result}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "L4 · 安全误放护栏 (A1)",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 23 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(review_rule_decisions_total{rule=\"ContentSafetyRule\",result=\"approved\"}[1d]))",
          "legendFormat": "安全规则放行(应=0)",
          "refId": "A"
        }
      ]
    }
  ]
}
